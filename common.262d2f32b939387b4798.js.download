    /**
        Put all relevant variables for both light and dark theme in this block only,
        do not bloat this block with other CSS rules.
    */
    :host {
        --navigation-button-height: 40px;
        --navigation-button-width: 40px;

        --msn-mobile-logo-width: 80px;
        --msn-mobile-logo-height: 30px;
        --msn-mobile-logo-optical-offset: 4px;

        --header-padding: 14px;
        --header-z-index: 6;
    }

    /**
        Put all relevant variables for only the light theme here,
        do not bloat this block with other CSS rules.
     */
    @media (prefers-color-scheme: light) {
        :host {
            --msn-alt-logo: url(${(0,a.rA)().StaticsUrl}latest/brand/new-msn-logo-color-black.svg);
            /**
                Temporary color palette that will be later moved to the design system provider
                as it gets upgraded to MSN UX.
            */
            --background-color: #fff;
            --foreground-color: #000;
            --list-item-background-color: #F5F5F5;

            /**
                Sometimes, icons are SVGs that come in black color by default. The fill color can only
                be changed programmatically, but as we want to retain pure CSS, this approach is a recommended 
                approach when handling dark/light theme switches.
            */
            --icon-luminance-filter: invert(0);

            --flyout-background: rgba(245, 245, 245, 0.85);
            --pri-text-color: #000;
            --sec-text-color: #4e4e4e;
            --separator: #ccc;
            --active-background: #f5f5f5;
        }

        :host fluent-select {
            background: #ffffff;
            color: #2b2b2b;
        }
    
        :host fluent-select::part(listbox) {
            background: #ffffff;
        }

        :host fluent-option:not([aria-selected="true"]) {
            color: #2b2b2b;
        }
    }
    /**
        Put all relevant variables for only the dark theme here,
        do not bloat this block with other CSS rules.
    */
    @media (prefers-color-scheme: dark) {
        :host {
            --msn-alt-logo: url(${(0,a.rA)().StaticsUrl}latest/brand/new-msn-logo-color-white.svg);

            /**
                Temporary color palette that will be later moved to the design system provider
                as it gets upgraded to MSN UX.
            */
            --background-color: #000;
            --foreground-color: #fff;
            --list-item-background-color: #222222;

            /**
                Sometimes, icons are SVGs that come in black color by default. The fill color can only
                be changed programmatically, but as we want to retain pure CSS, this approach is a recommended 
                approach when handling dark/light theme switches.
            */
            --icon-luminance-filter: invert(1);
            --flyout-background: rgba(17, 17, 17, 0.85);
            --pri-text-color: #fff;
            --sec-text-color: #d2d2d2;
            --separator: #333;
            --active-background: #222;
        }

        :host fluent-select {
            border-color: #444;
            background: #3b3b3b;
            color: #ffffff;
        }
    
        :host fluent-select::part(listbox) {
            background: #4a4a4a;
        }

        :host fluent-option:not([aria-selected="true"]) {
            color: #ffffff;
        }
    }

    /**
        Put all non-variable CSS rules below
    */
    
    :host .header-top-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--header-padding);
    }

    :host .msn-mobile-logo {
        width: var(--msn-mobile-logo-width);
        height: var(--msn-mobile-logo-height);
        bottom: var(--msn-mobile-logo-optical-offset);

        background: var(--msn-alt-logo) no-repeat center;
        background-size: contain;
        display: inline-block;

        position: relative;
    }

    :host .header-control {
        background: unset;
        border: unset;

        width: var(--navigation-button-width);
        height: var(--navigation-button-height);

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;
    }

    :host .header-control .msn-mobile-icon {
        filter: var(--icon-luminance-filter);
    }

    :host .header-controls-group {
        display: flex;
    }

    :host .header-mobile-container {
        background: var(--background-color);
    }

    :host {
        z-index: var(--header-z-index);
        position: var(--header-position, sticky);
        top: 0;
    }

    :host .sign-in-container-mobile {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        margin-bottom: 14px;
    }
    
    
    :host .left-side-section {
        display: flex;
        align-items: center;
        justify-content: left;
    }

    :host mail.button-mobile {
        padding-left: 5px;
    }

    :host .logo-icon {
        padding-left: 0;
    }

    :host .adjust-logo-padding {
        padding-right: 40px;
    }

    :host .side-menu-container {
        position: fixed;
        background: var(--background-color);
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        z-index: 999;
        color: var(--pri-text-color);
        display: flex;
        flex-flow: column;
    }

    @keyframes slide-in-right {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(0);
        }
    }

    @keyframes slide-in-left {
        from {
            transform: translateX(-100%);
        }
        to {
            transform: translateX(0);
        }
    }

    :host .search-box {
        height: 100%;
        padding: var(--header-padding);
        --search-box-width: 100%;
        --as-box-width: 100%;
        --search-svg-fill: currentColor;
    }

    :host([render-direction="ltr"]) .navigation-container {
        transform: translateX(-100%); /* Start off-screen to the left */
        animation: slide-in-left 0.3s forwards ease-in-out; /* Slide in on render */
    } 

    :host([render-direction="ltr"]) .search-container {
        transform: translateX(100%); /* Start off-screen to the right */
        animation: slide-in-right 0.3s forwards ease-in-out; /* Slide in on render */
    }

    :host([render-direction="rtl"]) .navigation-container {
        transform: translateX(100%); /* Start off-screen to the left */
        animation: slide-in-right 0.3s forwards ease-in-out; /* Slide in on render */
    } 

    :host([render-direction="rtl"]) .search-container {
        transform: translateX(-100%); /* Start off-screen to the right */
        animation: slide-in-left 0.3s forwards ease-in-out; /* Slide in on render */
    }

    .msn-navbar-mobile-footer {
        padding-bottom: 18px;
    }

    .default-feed-nav-container-mobile {
        overflow: hidden auto; 
    }
`,z=G.A`
    .content-icon-container {
        display: flex;
    }

    .select {
        height: 32px;
        margin-top: 12px;
        margin-bottom: 0px;
        padding: 21px 0px;
    }

    .select::part(listbox) {
        --max-height: 336px;
        height: 336px;
        margin: 21px 0px;
    }

    :host fluent-select {
        min-width: auto;
    }

    :host fluent-select::part(start) {
        display: contents;
    }

    :host fluent-select img.selector-icon {
        height: 16px;
        width: 16px;
        filter: var(--icon-luminance-filter);
    }

    :host fluent-select::part(selected-value) {
        font-size: clamp(14px, 4.25vw, 18px);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: normal;
    }

    :host fluent-select > fluent-option {
        font-size: clamp(14px, 4.25vw, 18px);
        line-height: normal;
    }

    .market-selector-wrapper {
        display: flex;
        flex-direction: column;
        margin: 0px 20px;
        font-size: clamp(16px, 4.25vw, 24px);
        padding: 18px 21px;
        border-radius: 12px;
        background: var(--list-item-background-color);
    }

    .market-selector-on-top {
        margin-top: 12px;
    }
