        padding: 0 0 0 15px;
    }

    li:first-child {
        padding-right: 0;
    }
    
    .list-mobile__new-header li:first-child {
        /* inherit <li> padding of 16px (see below) for the new header. We're using 'grid' and not 'flex' */
        padding-left: inherit;
    }

    .list-mobile__new-header li:first-child {
