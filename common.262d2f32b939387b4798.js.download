:host {
    width: inherit;
    --accent-fill-active: #717171;
    --accent-fill-hover: #717171;
    --neutral-fill-hover: #717171;
    --neutral-fill-stealth-hover: #EAEAEA;
    --neutral-fill-stealth-rest: transparent;
    --type-ramp-base-line-height: 15px;
}

feed-navigation::part(list-item) {
    padding: 0 11px;
}

.feed-nav-hp__new-header feed-navigation::part(list-item) {
    padding: 0;
}

feed-navigation::part(list-item)::after {
    border-right: 1px solid rgba(0, 0, 0, 0.15);
}

feed-navigation.mobile-navigation-item-parent::part(list-item) {
    padding: 0;
}

feed-navigation.mobile-navigation-item-parent::part(list-item-active) {
    padding: 0;
}

feed-navigation.mobile-navigation-item-parent::part(nav-item) {
    width: 100%;
}


feed-navigation.mobile-navigation-item-parent::part(navigation-item-separator) {
    background: #EBEBEB;
    height: 1px;
    width: 88%;
    bottom: 0;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}

.feed-nav-divider {
    /* border: 0 to prevent the <hr> element from taking extra space vertically */
    border: 0; 
    margin: 16px;
    border-bottom: 1px solid #CCCCCC;
}
